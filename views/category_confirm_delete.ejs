<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <h2 class="info">Confirm Deletion</h2>
  <p class="info">Are you sure you want to delete the category "<%= category.name %>"?</p>
  <p class="info">This will also delete all associated items.</p>

  <div class="buttons-container">
    <form action="/categories/<%= category.category_id %>/delete" method="POST">
      <button type="submit">Yes</button>
    </form>
    <a href="/categories" class="delete-btn">Cancel</a>
  </div>

  <%- include('./partials/footer') %>
</body>

</html>