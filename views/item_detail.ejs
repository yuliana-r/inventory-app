<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <div class="item-container">
    <a href="/items/<%= item.item_id %>" class="item-name"><%= item.name %></a>
    <div class="item-header">
      <p class="item-brand"><%= item.brand_name %> </p>
      <p>·</p>
      <p class="item-category"><%= item.category_name %></p>
    </div>
    <p class="item-qty"><%= item.qty %></p>
    <p class="item-unit"><%= item.unit_name %></p>
  </div>

  <div class="buttons-container">
    <a href="/items/<%= item.item_id %>/update" class="edit-btn">edit</a>
    <form action="/items/<%= item.item_id %>/delete" method="POST">
      <button type="submit">delete</button>
    </form>
  </div>

  <%- include('./partials/footer') %>
</body>

</html>