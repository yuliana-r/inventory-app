<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <a href="/brands/new" class="new-btn">
    new brand
  </a>

  <% if (brands_list.length > 0) { %>
  <% brands_list.forEach(function(brand) {%>
  <a href="/brands/<%= brand.brand_id %>" class="brand-link"><%= brand.name %></a>
  <%}); %>
  <% } else { %>
  <p>There are no brands to display yet. Why don't you create one <a href="/brands/new">here</a>?</p>
  <% } %>


  <%- include('./partials/footer') %>
</body>

</html>