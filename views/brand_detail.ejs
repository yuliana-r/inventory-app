<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>
  <p class="info"><%= brand.name %></p>

  <div class="buttons-container">
    <a href="/brands/<%= brand.brand_id %>/update" class="edit-btn">edit</a>
    <a href="/brands/<%= brand.brand_id %>/delete-confirm" class="delete-btn">delete</a>
  </div>

  <!-- display all items of this brand -->


  <% if (itemsOfBrand.length > 0) { %>
  <div class="items-list">
    <% itemsOfBrand.forEach(function(item) {%>

    <div class="item-container">
      <a href="/items/<%= item.item_id %>" class="item-name"><%= item.item_name %></a>
      <div class="item-header">
        <p class="item-brand"><%= item.brand_name %> </p>
        <p>·</p>
        <p class="item-category"><%= item.category_name %></p>
      </div>
      <p class="item-qty"><%= item.qty %></p>
      <p class="item-unit"><%= item.unit_name %></p>
    </div>

    <%}); %>
  </div>
  <% } %>


  <%- include('./partials/footer') %>
</body>

</html>