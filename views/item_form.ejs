<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>
  <%- include('./partials/navbar') %>

  <p><%= title%></p>

  <form action="<%= item ? `/items/${item.item_id}/update` : '/items/new' %>" method="POST">

    <label for="name">Name:</label>
    <input type="text" name="name" id="name" placeholder="Onion" value="<%= (item === undefined ? '' : item.name) %>" required>

    <label for="qty">Quantity</label>
    <input type="number" name="qty" id="qty" min="1" step=".01" value="<%= (item === undefined ? '' : item.qty) %>" required>

    <label for="unit">Unit:</label>
    <select name="unit_id" id="unit_id" required>
      <% units.forEach((unit) =>{ %>
      <option value="<%= unit.unit_id %>" <%= (item && unit.unit_id === item.unit_id) ? 'selected' :'' %>>
        <%= unit.name %>
      </option>
      <%}) %>
    </select>

    <label for="category">Category</label>
    <select name="category_id" id="category_id" required>
      <% categories.forEach((category) =>{ %>
      <option value="<%= category.category_id %>" <%= (item && category.category_id === item.category_id) ? 'selected' :'' %>><%= category.name %></option>
      <%}) %>
    </select>

    <label for="brand">Brand:</label>
    <select name="brand_id" id="brand_id" required>
      <% brands.forEach((brand) =>{ %>
      <option value="<%= brand.brand_id %>" <%= (item && brand.brand_id === item.brand_id) ? 'selected' : '' %>><%= brand.name %></option>
      <%}) %>
    </select>

    <button type="submit"><%= item ? 'update item' : 'add item' %></button>

  </form>
  <%- include('./partials/footer') %>
</body>

</html>