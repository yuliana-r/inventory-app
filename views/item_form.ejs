<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <p><%= title%></p>

  <% if (categories.length && brands.length){ %>
  <form action="<%= isUpdate && item?.item_id ? `/items/${item.item_id}/update` : '/items/new' %>" method="POST">

    <label for="name">Name:</label>
    <input type="text" name="name" id="name" placeholder="Onion" value="<%= item?.name || '' %>" required>

    <label for="qty">Quantity</label>
    <input type="number" name="qty" id="qty" min="1" step=".01" value="<%= (item === undefined ? '' : item.qty) %>" required>

    <label for="unit">Unit:</label>
    <select name="unit_id" id="unit_id" required>
      <% units.forEach((unit) =>{ %>
      <option value="<%= unit.unit_id %>" <%= (item && String(unit.unit_id) === String(item.unit_id)) ? 'selected' : '' %>>
        <%= unit.name %>
      </option>
      <%}) %>
    </select>

    <label for="category">Category</label>
    <select name="category_id" id="category_id" required>
      <% categories.forEach((category) =>{ %>
      <option value="<%= category.category_id %>" <%= (item && String(category.category_id) === String(item.category_id)) ? 'selected' : '' %>><%= category.name %></option>
      <%}) %>
    </select>

    <label for="brand">Brand:</label>
    <select name="brand_id" id="brand_id" required>
      <% brands.forEach((brand) =>{ %>
      <option value="<%= brand.brand_id %>" <%= (item && String(brand.brand_id) === String(item.brand_id)) ? 'selected' : '' %>><%= brand.name %></option>
      <%}) %>
    </select>


    <button type="submit"><%= isUpdate ? 'update item' : 'add item' %></button>

  </form>
  <%- include('./partials/validation_errors') %>
  <% } else {%>
  <p>You need to create the following before adding an item:</p>

  <ul>
    <% if (!categories.length) { %><li><a href="/categories/new">Create a category</a></li><% } %>
    <% if (!brands.length) { %><li><a href="/brands/new">Create a brand</a></li><% } %>
  </ul>

  <% } %>


  <%- include('./partials/footer') %>
</body>

</html>