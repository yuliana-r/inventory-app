<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>
  <p><%= title %></p>

  <form action="<%= isUpdate && category?.category_id ? `/categories/${category.category_id}/update` : '/categories/new' %>" method="POST">

    <label for="name">Category name</label>
    <input type="text" id="name" name="categoryName" placeholder="Miscellaneous" value="<%= category?.name || '' %>">

    <button type="submit"><%= isUpdate ? 'update category' : 'add category' %></button>
  </form>
  <% if (typeof errorMessage !== 'undefined') { %>
  <p><%= errorMessage %></p>
  <% } %>
  <%- include('./partials/validation_errors') %>
  <%- include('./partials/footer') %>
</body>

</html>