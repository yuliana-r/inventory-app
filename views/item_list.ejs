<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <a href="/items/new" class="new-btn">
    new item
  </a>

  <div class="items-list">
    <% if (items_list.length > 0) { %>
    <% items_list.forEach(function(item) {%>
    <div class="item-container">
      <a href="/items/<%= item.item_id %>" class="item-name"><%= item.item_name %></a>
      <div class="item-header">
        <p class="item-brand"><%= item.brand_name %> </p>
        <p>·</p>
        <p class="item-category"><%= item.category_name %></p>
      </div>
      <p class="item-qty"><%= item.qty %></p>
      <p class="item-unit"><%= item.unit_name %></p>
    </div>
    <%}); %>

  </div>
  <% } else { %>
  <p>There are no items to display yet. Why don't you create one <a href="/items/new">here</a>?</p>
  <% } %>

  <%- include('./partials/footer') %>
</body>

</html>