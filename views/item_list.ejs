<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body>
  <%- include('./partials/header') %>

  <a href="/items/new">
    <button>new item</button>
  </a>
  <% if (items_list.length > 0) { %>
  <% items_list.forEach(function(item) {%>
  <a href="/items/<%= item.item_id %>"><%= item.item_name %></a>
  <p><%= item.qty %></p>
  <p><%= item.unit_name %></p>
  <p><%= item.category_name %></p>
  <p><%= item.brand_name %></p>
  <%}); %>
  <% } else { %>
  <p>There are no items to display yet. Why don't you create one <a href="/items/new">here</a>?</p>
  <% } %>


  <%- include('./partials/footer') %>
</body>

</html>